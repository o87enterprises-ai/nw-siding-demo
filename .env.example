# ─────────────────────────────────────────────────────────────
# Northwest Siding — Production Environment Variables
# Configure these in Cloudflare Pages Dashboard -> Settings -> Environment Variables
# ─────────────────────────────────────────────────────────────

# [REQUIRED FOR LIVE EMAIL NOTIFICATIONS]
# Get your free key at https://resend.com (100 free emails/day, 3,000/month)
RESEND_API_KEY=re_123456789abcdef0123456789

# Where customer estimate inquiries should be emailed
CONTACT_EMAIL_TO=sidinggurus@northwestsiding.com

# Verified sender address configured in Resend (e.g. leads@northwestsiding.com or onboarding@resend.dev for test)
CONTACT_EMAIL_FROM=Northwest Siding <leads@northwestsiding.com>

# [OPTIONAL: CRM / LEAD AUTOMATION WEBHOOK]
# Send leads to Zapier, Make, HighLevel CRM, or Slack for 5-minute automated SMS alerts
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/123456/abcdef/

# [OPTIONAL: CLOUDFLARE TURNSTILE BOT PROTECTION]
# Free alternative to reCAPTCHA: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
